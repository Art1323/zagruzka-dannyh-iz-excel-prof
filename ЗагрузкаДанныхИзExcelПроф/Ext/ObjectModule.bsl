#Область ПрограммныйИнтерфейс

// Читает Excel/CSV/ODS из двоичных данных во временном хранилище.
// xlsx: OpenXML (список листов и выбранный лист), при ошибке — табличный документ.
// xls/ods: ТабличныйДокумент.Прочитать без COM.
// csv: ЧтениеТекста, разделитель определяется или берётся из параметров.
//
// Параметры:
//  АдресФайла - Строка
//  РасширениеФайла - Строка
//  ИмяЛиста - Строка
//  ПерваяСтрокаЗаголовки - Булево
//  РазделительCSV - Строка
//
// Возвращаемое значение:
//  Структура - Колонки, Строки, ИменаЛистов, ВсегоСтрок
//
Функция ПрочитатьФайлЗагрузки(АдресФайла, РасширениеФайла, ИмяЛиста, ПерваяСтрокаЗаголовки, РазделительCSV) Экспорт
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ДвоичныеДанные = Неопределено Тогда
		ВызватьИсключение "Файл не найден во временном хранилище. Выберите файл ещё раз.";
	КонецЕсли;
	
	Расширение = НРег(СтрЗаменить(РасширениеФайла, ".", ""));
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	Попытка
		Если Расширение = "csv" Тогда
			Результат = ПрочитатьCSV(ИмяВременногоФайла, ПерваяСтрокаЗаголовки, РазделительCSV);
		ИначеЕсли Расширение = "xlsx" Тогда
			Попытка
				Результат = ПрочитатьXLSXOpenXML(ИмяВременногоФайла, ИмяЛиста, ПерваяСтрокаЗаголовки);
			Исключение
				Результат = ПрочитатьЧерезТабличныйДокумент(ИмяВременногоФайла, ПерваяСтрокаЗаголовки);
			КонецПопытки;
		ИначеЕсли Расширение = "xls" Тогда
			Результат = ПрочитатьЧерезТабличныйДокумент(ИмяВременногоФайла, ПерваяСтрокаЗаголовки);
		ИначеЕсли Расширение = "ods" Тогда
			Результат = ПрочитатьЧерезТабличныйДокумент(ИмяВременногоФайла, ПерваяСтрокаЗаголовки);
		Иначе
			ВызватьИсключение "Неподдерживаемый тип файла: " + РасширениеФайла;
		КонецЕсли;
	Исключение
		УдалитьФайлБезопасно(ИмяВременногоФайла);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьФайлБезопасно(ИмяВременногоФайла);
	Возврат Результат;
	
КонецФункции

// Имена листов книги xlsx (OpenXML). Для прочих форматов — один элемент «Данные».
//
Функция ПолучитьИменаЛистов(АдресФайла, РасширениеФайла) Экспорт
	
	ИменаЛистов = Новый Массив;
	Расширение = НРег(СтрЗаменить(РасширениеФайла, ".", ""));
	
	Если Расширение <> "xlsx" Тогда
		ИменаЛистов.Добавить("Данные");
		Возврат ИменаЛистов;
	КонецЕсли;
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	Попытка
		ОписаниеКниги = ПрочитатьОписаниеКнигиXLSX(ИмяВременногоФайла);
		Для Каждого Лист Из ОписаниеКниги.Листы Цикл
			ИменаЛистов.Добавить(Лист.Имя);
		КонецЦикла;
	Исключение
		ИменаЛистов.Добавить("Данные");
	КонецПопытки;
	
	УдалитьФайлБезопасно(ИмяВременногоФайла);
	
	Если ИменаЛистов.Количество() = 0 Тогда
		ИменаЛистов.Добавить("Данные");
	КонецЕсли;
	
	Возврат ИменаЛистов;
	
КонецФункции

// Список объектов метаданных выбранного типа текущей конфигурации.
//
Функция ПолучитьСписокОбъектовМетаданных(ТипДанных) Экспорт
	
	Результат = Новый Массив;
	Коллекция = КоллекцияМетаданныхПоТипу(ТипДанных);
	Если Коллекция = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ОбъектМетаданных Из Коллекция Цикл
		Элемент = Новый Структура("Имя, Синоним, ПолноеИмя");
		Элемент.Имя = ОбъектМетаданных.Имя;
		Элемент.Синоним = ?(ПустаяСтрока(ОбъектМетаданных.Синоним), ОбъектМетаданных.Имя, ОбъектМетаданных.Синоним);
		Элемент.ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
		Результат.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Реквизиты / измерения / ресурсы / стандартные реквизиты / реквизиты ТЧ.
//
Функция ПолучитьОписаниеРеквизитовОбъекта(ТипДанных, ИмяОбъектаМетаданных) Экспорт
	
	Результат = Новый Массив;
	ОбъектМетаданных = НайтиОбъектМетаданных(ТипДанных, ИмяОбъектаМетаданных);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипДанных = "Справочник" Или ТипДанных = "Документ" Тогда
		ДобавитьСтандартныеРеквизиты(Результат, ОбъектМетаданных, ТипДанных);
		Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
			ДобавитьОписаниеРеквизита(Результат, Реквизит, "", "Реквизит");
		КонецЦикла;
		Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
			Для Каждого РеквизитТЧ Из ТабличнаяЧасть.Реквизиты Цикл
				ДобавитьОписаниеРеквизита(Результат, РеквизитТЧ, ТабличнаяЧасть.Имя, "ТабличнаяЧасть");
			КонецЦикла;
		КонецЦикла;
	ИначеЕсли ТипДанных = "РегистрСведений" Тогда
		РегистрПериодический = Ложь;
		Попытка
			РегистрПериодический = (ОбъектМетаданных.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический);
		Исключение
			Попытка
				РегистрПериодический = (ОбъектМетаданных.СтандартныеРеквизиты.Найти("Период") <> Неопределено);
			Исключение
				РегистрПериодический = Ложь;
			КонецПопытки;
		КонецПопытки;
		
		Если РегистрПериодический Тогда
			ДобавитьСлужебноеПоле(Результат, "Период", "Период", "Дата", "Измерение", Ложь, "", "");
		КонецЕсли;
		Для Каждого Измерение Из ОбъектМетаданных.Измерения Цикл
			ДобавитьОписаниеРеквизита(Результат, Измерение, "", "Измерение");
		КонецЦикла;
		Для Каждого Ресурс Из ОбъектМетаданных.Ресурсы Цикл
			ДобавитьОписаниеРеквизита(Результат, Ресурс, "", "Ресурс");
		КонецЦикла;
		Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
			ДобавитьОписаниеРеквизита(Результат, Реквизит, "", "Реквизит");
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Нестрогое сопоставление заголовков файла и синонимов реквизитов.
//
Функция ПодобратьСоответствиеКолонок(КолонкиФайла, ОписаниеРеквизитов) Экспорт
	
	Результат = Новый Массив;
	ЗанятыеРеквизиты = Новый Соответствие;
	
	Для Каждого КолонкаФайла Из КолонкиФайла Цикл
		СтрокаМаппинга = НоваяСтрокаМаппинга(КолонкаФайла);
		ЛучшийРеквизит = Неопределено;
		ЛучшийВес = 0;
		ЗаголовокНРег = НРег(СокрЛП(КолонкаФайла.Заголовок));
		
		Для Каждого Реквизит Из ОписаниеРеквизитов Цикл
			КлючРеквизита = Реквизит.ИмяТабличнойЧасти + "." + Реквизит.Имя;
			Если ЗанятыеРеквизиты.Получить(КлючРеквизита) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Вес = ВесСовпаденияИмен(ЗаголовокНРег, Реквизит);
			Если Вес > ЛучшийВес Тогда
				ЛучшийВес = Вес;
				ЛучшийРеквизит = Реквизит;
			КонецЕсли;
		КонецЦикла;
		
		Если ЛучшийРеквизит <> Неопределено И ЛучшийВес >= 50 Тогда
			ЗаполнитьМаппингПоРеквизиту(СтрокаМаппинга, ЛучшийРеквизит);
			ЗанятыеРеквизиты.Вставить(ЛучшийРеквизит.ИмяТабличнойЧасти + "." + ЛучшийРеквизит.Имя, Истина);
		КонецЕсли;
		
		Результат.Добавить(СтрокаМаппинга);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Загружает порцию строк. Транзакция — на каждую строку файла.
// Кэш ссылок хранится во временном хранилище между порциями.
//
Функция ВыполнитьЗагрузкуПорции(АдресДанныхФайла, АдресКэшаСсылок, ПараметрыЗагрузки) Экспорт
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресДанныхФайла);
	КэшСсылок = ПолучитьИзВременногоХранилища(АдресКэшаСсылок);
	Если КэшСсылок = Неопределено Тогда
		КэшСсылок = Новый Соответствие;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("Протокол", Новый Массив);
	Результат.Вставить("Создано", 0);
	Результат.Вставить("Обновлено", 0);
	Результат.Вставить("Ошибок", 0);
	Результат.Вставить("Пропущено", 0);
	Результат.Вставить("Прервано", Ложь);
	Результат.Вставить("СообщениеПрерывания", "");
	
	Начало = ПараметрыЗагрузки.НачальнаяСтрока;
	КонецПорции = Мин(ДанныеФайла.Строки.Количество(), Начало + ПараметрыЗагрузки.КоличествоСтрок) - 1;
	
	Для ИндексСтроки = Начало По КонецПорции Цикл
		
		НомерСтрокиФайла = ИндексСтроки + 1;
		Если ДанныеФайла.Свойство("НомерПервойСтрокиДанных") Тогда
			НомерСтрокиФайла = ДанныеФайла.НомерПервойСтрокиДанных + ИндексСтроки;
		КонецЕсли;
		
		НачатьТранзакцию();
		Попытка
			СтрокаРезультата = ЗагрузитьОднуСтроку(
				ДанныеФайла.Строки[ИндексСтроки],
				ДанныеФайла.Колонки,
				ПараметрыЗагрузки,
				КэшСсылок,
				НомерСтрокиФайла);
			ЗафиксироватьТранзакцию();
			
			Результат.Протокол.Добавить(СтрокаРезультата);
			Если СтрокаРезультата.Статус = "Создан" Тогда
				Результат.Создано = Результат.Создано + 1;
			ИначеЕсли СтрокаРезультата.Статус = "Обновлен" Тогда
				Результат.Обновлено = Результат.Обновлено + 1;
			ИначеЕсли СтрокаРезультата.Статус = "Пропущен" Тогда
				Результат.Пропущено = Результат.Пропущено + 1;
			КонецЕсли;
		Исключение
			ОтменитьТранзакцию();
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			СтрокаОшибки = НовыйЭлементПротокола(НомерСтрокиФайла, "Ошибка", ТекстОшибки, "", "");
			Результат.Протокол.Добавить(СтрокаОшибки);
			Результат.Ошибок = Результат.Ошибок + 1;
			
			Если ПараметрыЗагрузки.ПрерыватьПриОшибке Тогда
				Результат.Прервано = Истина;
				Результат.СообщениеПрерывания = СтрШаблон("Загрузка прервана на строке %1: %2", НомерСтрокиФайла, ТекстОшибки);
				Прервать;
			КонецЕсли;
		КонецПопытки;
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(КэшСсылок, АдресКэшаСсылок);
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЧтениеФайлов

Функция ПрочитатьЧерезТабличныйДокумент(ИмяФайла, ПерваяСтрокаЗаголовки)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ИмяФайла);
	
	Высота = ТабличныйДокумент.ВысотаТаблицы;
	Ширина = ТабличныйДокумент.ШиринаТаблицы;
	Если Высота = 0 Или Ширина = 0 Тогда
		ВызватьИсключение "Файл не содержит данных.";
	КонецЕсли;
	
	МассивСтрок = Новый Массив;
	Для НомерСтроки = 1 По Высота Цикл
		СтрокаЗначений = Новый Массив;
		Для НомерКолонки = 1 По Ширина Цикл
			СтрокаЗначений.Добавить(СокрЛП(Строка(ТабличныйДокумент.Область(НомерСтроки, НомерКолонки).Текст)));
		КонецЦикла;
		МассивСтрок.Добавить(СтрокаЗначений);
	КонецЦикла;
	
	Возврат СобратьРезультатЧтения(МассивСтрок, ПерваяСтрокаЗаголовки);
	
КонецФункции

Функция ПрочитатьCSV(ИмяФайла, ПерваяСтрокаЗаголовки, РазделительCSV)
	
	Кодировка = ОпределитьКодировкуТекста(ИмяФайла);
	ЧтениеТекста = Новый ЧтениеТекста(ИмяФайла, Кодировка);
	
	МассивСтрок = Новый Массив;
	ПерваяСтрока = ЧтениеТекста.ПрочитатьСтроку();
	Если ПерваяСтрока = Неопределено Тогда
		ЧтениеТекста.Закрыть();
		ВызватьИсключение "CSV-файл пуст.";
	КонецЕсли;
	
	Разделитель = РазделительCSV;
	Если ПустаяСтрока(Разделитель) Тогда
		Разделитель = ОпределитьРазделительCSV(ПерваяСтрока);
	КонецЕсли;
	
	МассивСтрок.Добавить(РазобратьСтрокуCSV(ПерваяСтрока, Разделитель));
	
	Пока Истина Цикл
		СтрокаФайла = ЧтениеТекста.ПрочитатьСтроку();
		Если СтрокаФайла = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если ПустаяСтрока(СтрокаФайла) Тогда
			Продолжить;
		КонецЕсли;
		МассивСтрок.Добавить(РазобратьСтрокуCSV(СтрокаФайла, Разделитель));
	КонецЦикла;
	
	ЧтениеТекста.Закрыть();
	Возврат СобратьРезультатЧтения(МассивСтрок, ПерваяСтрокаЗаголовки);
	
КонецФункции

Функция ПрочитатьXLSXOpenXML(ИмяФайла, ИмяЛиста, ПерваяСтрокаЗаголовки)
	
	Каталог = ПолучитьИмяВременногоФайла() + "xlsx";
	СоздатьКаталог(Каталог);
	
	Попытка
		ЧтениеZip = Новый ЧтениеZipФайла(ИмяФайла);
		ЧтениеZip.ИзвлечьВсе(Каталог);
		ЧтениеZip.Закрыть();
		
		ОписаниеКниги = ПрочитатьОписаниеКнигиИзКаталога(Каталог);
		ПутьЛиста = ПутьФайлаЛиста(ОписаниеКниги, ИмяЛиста, Каталог);
		ОбщиеСтроки = ПрочитатьОбщиеСтрокиXLSX(Каталог);
		МассивСтрок = ПрочитатьЯчейкиЛистаXLSX(ПутьЛиста, ОбщиеСтроки);
	Исключение
		УдалитьФайлБезопасно(Каталог);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьФайлБезопасно(Каталог);
	Результат = СобратьРезультатЧтения(МассивСтрок, ПерваяСтрокаЗаголовки);
	
	ИменаЛистов = Новый Массив;
	Для Каждого Лист Из ОписаниеКниги.Листы Цикл
		ИменаЛистов.Добавить(Лист.Имя);
	КонецЦикла;
	Результат.ИменаЛистов = ИменаЛистов;
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьОписаниеКнигиXLSX(ИмяФайла)
	
	Каталог = ПолучитьИмяВременногоФайла() + "xlsx";
	СоздатьКаталог(Каталог);
	Попытка
		ЧтениеZip = Новый ЧтениеZipФайла(ИмяФайла);
		ЧтениеZip.ИзвлечьВсе(Каталог);
		ЧтениеZip.Закрыть();
		ОписаниеКниги = ПрочитатьОписаниеКнигиИзКаталога(Каталог);
	Исключение
		УдалитьФайлБезопасно(Каталог);
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлБезопасно(Каталог);
	Возврат ОписаниеКниги;
	
КонецФункции

Функция ПрочитатьОписаниеКнигиИзКаталога(Каталог)
	
	Разд = ПолучитьРазделительПути();
	ПутьWorkbook = Каталог + Разд + "xl" + Разд + "workbook.xml";
	ПутьRels = Каталог + Разд + "xl" + Разд + "_rels" + Разд + "workbook.xml.rels";
	
	Связи = Новый Соответствие;
	Если ФайлСуществует(ПутьRels) Тогда
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(ПутьRels);
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "Relationship" Тогда
				Ид = "";
				Цель = "";
				Пока Чтение.ПрочитатьАтрибут() Цикл
					Если Чтение.ЛокальноеИмя = "Id" Тогда
						Ид = Чтение.Значение;
					ИначеЕсли Чтение.ЛокальноеИмя = "Target" Тогда
						Цель = Чтение.Значение;
					КонецЕсли;
				КонецЦикла;
				Связи.Вставить(Ид, Цель);
			КонецЕсли;
		КонецЦикла;
		Чтение.Закрыть();
	КонецЕсли;
	
	Листы = Новый Массив;
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ПутьWorkbook);
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "sheet" Тогда
			ИмяЛиста = "";
			ИдСвязи = "";
			Пока Чтение.ПрочитатьАтрибут() Цикл
				Если Чтение.ЛокальноеИмя = "name" Тогда
					ИмяЛиста = Чтение.Значение;
				ИначеЕсли Чтение.ЛокальноеИмя = "id" Тогда
					ИдСвязи = Чтение.Значение;
				КонецЕсли;
			КонецЦикла;
			Лист = Новый Структура("Имя, Файл", ИмяЛиста, Строка(Связи.Получить(ИдСвязи)));
			Листы.Добавить(Лист);
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	
	Возврат Новый Структура("Листы", Листы);
	
КонецФункции

Функция ПутьФайлаЛиста(ОписаниеКниги, ИмяЛиста, Каталог)
	
	Разд = ПолучитьРазделительПути();
	Выбранный = Неопределено;
	Для Каждого Лист Из ОписаниеКниги.Листы Цикл
		Если ПустаяСтрока(ИмяЛиста) Или Лист.Имя = ИмяЛиста Тогда
			Выбранный = Лист;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Выбранный = Неопределено И ОписаниеКниги.Листы.Количество() > 0 Тогда
		Выбранный = ОписаниеКниги.Листы[0];
	КонецЕсли;
	Если Выбранный = Неопределено Тогда
		ВызватьИсключение "В книге нет листов.";
	КонецЕсли;
	
	Цель = СтрЗаменить(Выбранный.Файл, "/", Разд);
	Если СтрНачинаетсяС(Цель, Разд) Тогда
		Цель = Сред(Цель, 2);
	КонецЕсли;
	Если СтрНачинаетсяС(НРег(Цель), "xl" + Разд) Тогда
		Возврат Каталог + Разд + Цель;
	КонецЕсли;
	Возврат Каталог + Разд + "xl" + Разд + Цель;
	
КонецФункции

Функция ПрочитатьОбщиеСтрокиXLSX(Каталог)
	
	ОбщиеСтроки = Новый Массив;
	Разд = ПолучитьРазделительПути();
	Путь = Каталог + Разд + "xl" + Разд + "sharedStrings.xml";
	Если Не ФайлСуществует(Путь) Тогда
		Возврат ОбщиеСтроки;
	КонецЕсли;
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(Путь);
	Текущая = "";
	ВнутриSI = Ложь;
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "si" Тогда
			ВнутриSI = Истина;
			Текущая = "";
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.ЛокальноеИмя = "si" Тогда
			ОбщиеСтроки.Добавить(Текущая);
			ВнутриSI = Ложь;
		ИначеЕсли ВнутриSI И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.ЛокальноеИмя = "t" Тогда
			Чтение.Прочитать();
			Если Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
				Текущая = Текущая + Чтение.Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	Возврат ОбщиеСтроки;
	
КонецФункции

Функция ПрочитатьЯчейкиЛистаXLSX(ПутьЛиста, ОбщиеСтроки)
	
	СтрокиПоНомерам = Новый Соответствие;
	МаксКолонка = 0;
	МаксСтрока = 0;
	НомерСтроки = 0;
	НомерКолонки = 0;
	ТипЯчейки = "";
	ЗначениеЯчейки = "";
	ВнутриЗначения = Ложь;
	ВнутриInline = Ложь;
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ПутьЛиста);
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.ЛокальноеИмя = "row" Тогда
				НомерСтроки = ЧислоИзАтрибута(Чтение, "r", МаксСтрока + 1);
			ИначеЕсли Чтение.ЛокальноеИмя = "c" Тогда
				ТипЯчейки = "";
				ЗначениеЯчейки = "";
				Адрес = "";
				Пока Чтение.ПрочитатьАтрибут() Цикл
					Если Чтение.ЛокальноеИмя = "r" Тогда
						Адрес = Чтение.Значение;
					ИначеЕсли Чтение.ЛокальноеИмя = "t" Тогда
						ТипЯчейки = Чтение.Значение;
					КонецЕсли;
				КонецЦикла;
				НомерКолонки = ИндексКолонкиИзАдреса(Адрес);
			ИначеЕсли Чтение.ЛокальноеИмя = "v" Тогда
				ВнутриЗначения = Истина;
			ИначеЕсли Чтение.ЛокальноеИмя = "t" И ТипЯчейки = "inlineStr" Тогда
				ВнутриInline = Истина;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
			Если ВнутриЗначения Или ВнутриInline Тогда
				ЗначениеЯчейки = Чтение.Значение;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Если Чтение.ЛокальноеИмя = "v" Тогда
				ВнутриЗначения = Ложь;
			ИначеЕсли Чтение.ЛокальноеИмя = "t" Тогда
				ВнутриInline = Ложь;
			ИначеЕсли Чтение.ЛокальноеИмя = "c" Тогда
				ТекстЯчейки = ЗначениеЯчейкиПоТипу(ТипЯчейки, ЗначениеЯчейки, ОбщиеСтроки);
				Если НомерСтроки > 0 И НомерКолонки > 0 Тогда
					СтрокаЗначений = СтрокиПоНомерам.Получить(НомерСтроки);
					Если СтрокаЗначений = Неопределено Тогда
						СтрокаЗначений = Новый Соответствие;
						СтрокиПоНомерам.Вставить(НомерСтроки, СтрокаЗначений);
					КонецЕсли;
					СтрокаЗначений.Вставить(НомерКолонки, ТекстЯчейки);
					МаксКолонка = Макс(МаксКолонка, НомерКолонки);
					МаксСтрока = Макс(МаксСтрока, НомерСтроки);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	
	МассивСтрок = Новый Массив;
	Для Номер = 1 По МаксСтрока Цикл
		СтрокаЗначений = Новый Массив;
		ДанныеСтроки = СтрокиПоНомерам.Получить(Номер);
		Для Колонка = 1 По МаксКолонка Цикл
			Значение = "";
			Если ДанныеСтроки <> Неопределено И ДанныеСтроки.Получить(Колонка) <> Неопределено Тогда
				Значение = ДанныеСтроки.Получить(Колонка);
			КонецЕсли;
			СтрокаЗначений.Добавить(Значение);
		КонецЦикла;
		МассивСтрок.Добавить(СтрокаЗначений);
	КонецЦикла;
	
	Возврат МассивСтрок;
	
КонецФункции

Функция СобратьРезультатЧтения(МассивСтрок, ПерваяСтрокаЗаголовки)
	
	Если МассивСтрок.Количество() = 0 Тогда
		ВызватьИсключение "Нет строк для загрузки.";
	КонецЕсли;
	
	Ширина = 0;
	Для Каждого СтрокаЗначений Из МассивСтрок Цикл
		Ширина = Макс(Ширина, СтрокаЗначений.Количество());
	КонецЦикла;
	
	Колонки = Новый Массив;
	ИндексДанных = 0;
	Если ПерваяСтрокаЗаголовки Тогда
		Заголовки = МассивСтрок[0];
		ИндексДанных = 1;
		Для НомерКолонки = 1 По Ширина Цикл
			Заголовок = "";
			Если НомерКолонки <= Заголовки.Количество() Тогда
				Заголовок = СокрЛП(Строка(Заголовки[НомерКолонки - 1]));
			КонецЕсли;
			Если ПустаяСтрока(Заголовок) Тогда
				Заголовок = "Колонка" + Формат(НомерКолонки, "ЧГ=0");
			КонецЕсли;
			Колонки.Добавить(Новый Структура("Имя, Заголовок, Индекс", "К" + Формат(НомерКолонки, "ЧГ=0"), Заголовок, НомерКолонки - 1));
		КонецЦикла;
	Иначе
		Для НомерКолонки = 1 По Ширина Цикл
			Заголовок = "Колонка" + Формат(НомерКолонки, "ЧГ=0");
			Колонки.Добавить(Новый Структура("Имя, Заголовок, Индекс", "К" + Формат(НомерКолонки, "ЧГ=0"), Заголовок, НомерКолонки - 1));
		КонецЦикла;
	КонецЕсли;
	
	СтрокиДанных = Новый Массив;
	Для Индекс = ИндексДанных По МассивСтрок.Количество() - 1 Цикл
		Исходная = МассивСтрок[Индекс];
		Если СтрокаПустая(Исходная) Тогда
			Продолжить;
		КонецЕсли;
		Значения = Новый Массив;
		Для НомерКолонки = 1 По Ширина Цикл
			Если НомерКолонки <= Исходная.Количество() Тогда
				Значения.Добавить(СокрЛП(Строка(Исходная[НомерКолонки - 1])));
			Иначе
				Значения.Добавить("");
			КонецЕсли;
		КонецЦикла;
		СтрокиДанных.Добавить(Значения);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("Колонки", Колонки);
	Результат.Вставить("Строки", СтрокиДанных);
	Результат.Вставить("ВсегоСтрок", СтрокиДанных.Количество());
	Результат.Вставить("ИменаЛистов", Новый Массив);
	Результат.Вставить("НомерПервойСтрокиДанных", ?(ПерваяСтрокаЗаголовки, 2, 1));
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ЗагрузкаСтроки

Функция ЗагрузитьОднуСтроку(ЗначенияСтроки, КолонкиФайла, ПараметрыЗагрузки, КэшСсылок, НомерСтрокиФайла)
	
	ЗначенияПоКолонкам = Новый Соответствие;
	Для Каждого Колонка Из КолонкиФайла Цикл
		Значение = "";
		Если Колонка.Индекс < ЗначенияСтроки.Количество() Тогда
			Значение = ЗначенияСтроки[Колонка.Индекс];
		КонецЕсли;
		ЗначенияПоКолонкам.Вставить(Колонка.Имя, Значение);
	КонецЦикла;
	
	Если ПараметрыЗагрузки.ТипДанных = "РегистрСведений" Тогда
		Возврат ЗагрузитьСтрокуРегистра(ЗначенияПоКолонкам, ПараметрыЗагрузки, КэшСсылок, НомерСтрокиФайла);
	КонецЕсли;
	
	Возврат ЗагрузитьСтрокуСсылочногоОбъекта(ЗначенияПоКолонкам, ПараметрыЗагрузки, КэшСсылок, НомерСтрокиФайла);
	
КонецФункции

Функция ЗагрузитьСтрокуСсылочногоОбъекта(ЗначенияПоКолонкам, ПараметрыЗагрузки, КэшСсылок, НомерСтрокиФайла)
	
	ПоляШапки = Новый Массив;
	ПоляТЧ = Новый Соответствие;
	
	Для Каждого СтрокаМаппинга Из ПараметрыЗагрузки.Маппинг Цикл
		Если ПустаяСтрока(СтрокаМаппинга.ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(СтрокаМаппинга.ИмяТабличнойЧасти) Тогда
			ПоляШапки.Добавить(СтрокаМаппинга);
		Иначе
			НаборТЧ = ПоляТЧ.Получить(СтрокаМаппинга.ИмяТабличнойЧасти);
			Если НаборТЧ = Неопределено Тогда
				НаборТЧ = Новый Массив;
				ПоляТЧ.Вставить(СтрокаМаппинга.ИмяТабличнойЧасти, НаборТЧ);
			КонецЕсли;
			НаборТЧ.Добавить(СтрокаМаппинга);
		КонецЕсли;
	КонецЦикла;
	
	СуществующаяСсылка = Неопределено;
	Если Не ВсегдаСоздаватьОбъект(ПоляШапки) Тогда
		СуществующаяСсылка = НайтиОсновнойОбъект(ЗначенияПоКолонкам, ПоляШапки, ПараметрыЗагрузки, КэшСсылок);
	КонецЕсли;
	
	ЭтоОбновление = ЗначениеЗаполнено(СуществующаяСсылка);
	Если ЭтоОбновление Тогда
		ОбъектЗаписи = СуществующаяСсылка.ПолучитьОбъект();
		ОбъектЗаписи.Заблокировать();
	Иначе
		ОбъектЗаписи = СоздатьОбъектМетаданных(ПараметрыЗагрузки.ТипДанных, ПараметрыЗагрузки.ИмяОбъектаМетаданных);
	КонецЕсли;
	
	Для Каждого СтрокаМаппинга Из ПоляШапки Цикл
		ЗначениеФайла = ЗначенияПоКолонкам.Получить(СтрокаМаппинга.ИмяКолонкиФайла);
		ЗначениеРеквизита = ПолучитьЗначениеРеквизита(ЗначениеФайла, СтрокаМаппинга, ПараметрыЗагрузки, КэшСсылок, Ложь);
		УстановитьРеквизитОбъекта(ОбъектЗаписи, СтрокаМаппинга.ИмяРеквизита, ЗначениеРеквизита);
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из ПоляТЧ Цикл
		ТабличнаяЧасть = ОбъектЗаписи[КлючИЗначение.Ключ];
		Если ЭтоОбновление Тогда
			ТабличнаяЧасть.Очистить();
		КонецЕсли;
		СтрокаТЧ = ТабличнаяЧасть.Добавить();
		Для Каждого СтрокаМаппинга Из КлючИЗначение.Значение Цикл
			ЗначениеФайла = ЗначенияПоКолонкам.Получить(СтрокаМаппинга.ИмяКолонкиФайла);
			ЗначениеРеквизита = ПолучитьЗначениеРеквизита(ЗначениеФайла, СтрокаМаппинга, ПараметрыЗагрузки, КэшСсылок, Ложь);
			СтрокаТЧ[СтрокаМаппинга.ИмяРеквизита] = ЗначениеРеквизита;
		КонецЦикла;
	КонецЦикла;
	
	ОбъектЗаписи.Записать();
	
	Статус = ?(ЭтоОбновление, "Обновлен", "Создан");
	СсылкаОбъекта = ОбъектЗаписи.Ссылка;
	Возврат НовыйЭлементПротокола(
		НомерСтрокиФайла,
		Статус,
		"",
		ПолучитьНавигационнуюСсылку(СсылкаОбъекта),
		Строка(СсылкаОбъекта));
	
КонецФункции

Функция ЗагрузитьСтрокуРегистра(ЗначенияПоКолонкам, ПараметрыЗагрузки, КэшСсылок, НомерСтрокиФайла)
	
	МенеджерЗаписи = РегистрыСведений[ПараметрыЗагрузки.ИмяОбъектаМетаданных].СоздатьМенеджерЗаписи();
	
	Для Каждого СтрокаМаппинга Из ПараметрыЗагрузки.Маппинг Цикл
		Если ПустаяСтрока(СтрокаМаппинга.ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеФайла = ЗначенияПоКолонкам.Получить(СтрокаМаппинга.ИмяКолонкиФайла);
		ЗначениеРеквизита = ПолучитьЗначениеРеквизита(ЗначениеФайла, СтрокаМаппинга, ПараметрыЗагрузки, КэшСсылок, Ложь);
		МенеджерЗаписи[СтрокаМаппинга.ИмяРеквизита] = ЗначениеРеквизита;
	КонецЦикла;
	
	МенеджерЗаписи.Прочитать();
	ЭтоОбновление = МенеджерЗаписи.Выбран();
	
	Для Каждого СтрокаМаппинга Из ПараметрыЗагрузки.Маппинг Цикл
		Если ПустаяСтрока(СтрокаМаппинга.ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеФайла = ЗначенияПоКолонкам.Получить(СтрокаМаппинга.ИмяКолонкиФайла);
		ЗначениеРеквизита = ПолучитьЗначениеРеквизита(ЗначениеФайла, СтрокаМаппинга, ПараметрыЗагрузки, КэшСсылок, Ложь);
		МенеджерЗаписи[СтрокаМаппинга.ИмяРеквизита] = ЗначениеРеквизита;
	КонецЦикла;
	
	МенеджерЗаписи.Записать(Истина);
	
	Статус = ?(ЭтоОбновление, "Обновлен", "Создан");
	Возврат НовыйЭлементПротокола(НомерСтрокиФайла, Статус, "Запись регистра сведений", "", "");
	
КонецФункции

Функция ПолучитьЗначениеРеквизита(ЗначениеФайла, СтрокаМаппинга, ПараметрыЗагрузки, КэшСсылок, ЭтоПоискОсновного)
	
	Если СтрокаМаппинга.ЭтоСсылка Тогда
		Возврат ПолучитьСсылкуПоЗначениюФайла(ЗначениеФайла, СтрокаМаппинга, ПараметрыЗагрузки, КэшСсылок);
	КонецЕсли;
	
	Возврат ПривестиЗначение(ЗначениеФайла, СтрокаМаппинга.ИмяРеквизита, ПараметрыЗагрузки);
	
КонецФункции

#КонецОбласти

#Область ПоискСсылок

Функция ПолучитьСсылкуПоЗначениюФайла(ЗначениеФайла, СтрокаМаппинга, ПараметрыЗагрузки, КэшСсылок)
	
	Если Не ЗначениеЗаполнено(ЗначениеФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПолноеИмя = СтрокаМаппинга.ПолноеИмяСсылочногоТипа;
	Если ПустаяСтрока(ПолноеИмя) Тогда
		ВызватьИсключение "Не задан тип ссылки для реквизита " + СтрокаМаппинга.ИмяРеквизита;
	КонецЕсли;
	
	ИмяРеквизитаПоиска = СтрокаМаппинга.ИмяРеквизитаПоискаСсылки;
	Если ПустаяСтрока(ИмяРеквизитаПоиска) Тогда
		ИмяРеквизитаПоиска = ИмяРеквизитаПоискаПоУмолчанию(ПолноеИмя);
	КонецЕсли;
	
	ОсновноеЗначение = СокрЛП(Строка(ЗначениеФайла));
	ЗначениеРодителя = "";
	Если СтрокаМаппинга.РазбиратьСоставнойКлюч Тогда
		Разделитель = ?(ПустаяСтрока(СтрокаМаппинга.РазделительКлюча), ПараметрыЗагрузки.РазделительСоставногоКлюча, СтрокаМаппинга.РазделительКлюча);
		Если ПустаяСтрока(Разделитель) Тогда
			Разделитель = "/";
		КонецЕсли;
		Части = СтрРазделить(ОсновноеЗначение, Разделитель, Ложь);
		Если Части.Количество() > 0 Тогда
			ОсновноеЗначение = СокрЛП(Части[0]);
		КонецЕсли;
		Если Части.Количество() > 1 Тогда
			ЗначениеРодителя = СокрЛП(Части[1]);
		КонецЕсли;
	КонецЕсли;
	
	КлючКэша = ПолноеИмя + "|" + ИмяРеквизитаПоиска + "|" + НРег(ОсновноеЗначение) + "|" + НРег(ЗначениеРодителя);
	Кэшированное = КэшСсылок.Получить(КлючКэша);
	Если Кэшированное <> Неопределено Тогда
		Возврат Кэшированное;
	КонецЕсли;
	
	Ссылка = НайтиСсылкуЗапросом(ПолноеИмя, ИмяРеквизитаПоиска, ОсновноеЗначение, ЗначениеРодителя);
	
	Если ЗначениеЗаполнено(Ссылка) Тогда
		КэшСсылок.Вставить(КлючКэша, Ссылка);
		Возврат Ссылка;
	КонецЕсли;
	
	Действие = СтрокаМаппинга.ДействиеЕслиНеНайден;
	Если Действие = "Прервать" Тогда
		ВызватьИсключение СтрШаблон(
			"Не найден объект %1 по реквизиту %2 = «%3»",
			ПолноеИмя,
			ИмяРеквизитаПоиска,
			ОсновноеЗначение);
	ИначеЕсли Действие = "СоздатьНовый" Тогда
		Ссылка = СоздатьСсылочныйОбъект(ПолноеИмя, ИмяРеквизитаПоиска, ОсновноеЗначение, ЗначениеРодителя, КэшСсылок);
		КэшСсылок.Вставить(КлючКэша, Ссылка);
		Возврат Ссылка;
	Иначе
		ПустаяСсылка = МенеджерПоПолномуИмени(ПолноеИмя).ПустаяСсылка();
		КэшСсылок.Вставить(КлючКэша, ПустаяСсылка);
		Возврат ПустаяСсылка;
	КонецЕсли;
	
КонецФункции

Функция НайтиСсылкуЗапросом(ПолноеИмя, ИмяРеквизитаПоиска, ЗначениеПоиска, ЗначениеРодителя)
	
	ПроверитьИмяРеквизитаПоиска(ПолноеИмя, ИмяРеквизитаПоиска);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	" + ПолноеИмя + " КАК Т
	|ГДЕ
	|	Т." + ИмяРеквизитаПоиска + " = &Значение";
	
	Если ЕстьСтандартныйРеквизит(ПолноеИмя, "ПометкаУдаления") Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И НЕ Т.ПометкаУдаления";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначениеРодителя) И ЕстьСтандартныйРеквизит(ПолноеИмя, "Родитель") Тогда
		Родитель = НайтиСсылкуЗапросом(ПолноеИмя, "Наименование", ЗначениеРодителя, "");
		Если Не ЗначениеЗаполнено(Родитель) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + "
		|	И Т.Родитель = &Родитель";
		Запрос.УстановитьПараметр("Родитель", Родитель);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Значение", ПривестиЗначениеПоиска(ПолноеИмя, ИмяРеквизитаПоиска, ЗначениеПоиска));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СоздатьСсылочныйОбъект(ПолноеИмя, ИмяРеквизитаПоиска, ЗначениеПоиска, ЗначениеРодителя, КэшСсылок)
	
	ЧастиИмени = СтрРазделить(ПолноеИмя, ".");
	Вид = ЧастиИмени[0];
	Имя = ЧастиИмени[1];
	
	Если Вид <> "Справочник" Тогда
		ВызватьИсключение "Автосоздание поддерживается только для справочников. Объект: " + ПолноеИмя;
	КонецЕсли;
	
	НовыйОбъект = Справочники[Имя].СоздатьЭлемент();
	ЗначениеРеквизита = ПривестиЗначениеПоиска(ПолноеИмя, ИмяРеквизитаПоиска, ЗначениеПоиска);
	
	Если ИмяРеквизитаПоиска = "Наименование" Тогда
		НовыйОбъект.Наименование = ЗначениеРеквизита;
	ИначеЕсли ИмяРеквизитаПоиска = "Код" Тогда
		НовыйОбъект.Код = ЗначениеРеквизита;
		Если Метаданные.Справочники[Имя].ДлинаНаименования > 0 Тогда
			НовыйОбъект.Наименование = Лев(Строка(ЗначениеПоиска), Метаданные.Справочники[Имя].ДлинаНаименования);
		КонецЕсли;
	Иначе
		НовыйОбъект[ИмяРеквизитаПоиска] = ЗначениеРеквизита;
		Если Метаданные.Справочники[Имя].ДлинаНаименования > 0 Тогда
			НовыйОбъект.Наименование = Лев(Строка(ЗначениеПоиска), Метаданные.Справочники[Имя].ДлинаНаименования);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЗначениеРодителя) И Метаданные.Справочники[Имя].Иерархический Тогда
		Родитель = НайтиСсылкуЗапросом(ПолноеИмя, "Наименование", ЗначениеРодителя, "");
		Если Не ЗначениеЗаполнено(Родитель) Тогда
			СтрокаРодителя = Новый Структура;
			СтрокаРодителя.Вставить("ПолноеИмяСсылочногоТипа", ПолноеИмя);
			СтрокаРодителя.Вставить("ИмяРеквизитаПоискаСсылки", "Наименование");
			СтрокаРодителя.Вставить("ДействиеЕслиНеНайден", "СоздатьНовый");
			СтрокаРодителя.Вставить("РазбиратьСоставнойКлюч", Ложь);
			СтрокаРодителя.Вставить("РазделительКлюча", "");
			СтрокаРодителя.Вставить("ИмяРеквизита", "Родитель");
			Родитель = ПолучитьСсылкуПоЗначениюФайла(ЗначениеРодителя, СтрокаРодителя, Новый Структура("РазделительСоставногоКлюча", "/"), КэшСсылок);
		КонецЕсли;
		НовыйОбъект.Родитель = Родитель;
	КонецЕсли;
	
	НовыйОбъект.Записать();
	Возврат НовыйОбъект.Ссылка;
	
КонецФункции

Функция НайтиОсновнойОбъект(ЗначенияПоКолонкам, ПоляШапки, ПараметрыЗагрузки, КэшСсылок)
	
	Условия = Новый Массив;
	Запрос = Новый Запрос;
	ИндексПараметра = 0;
	
	Для Каждого СтрокаМаппинга Из ПоляШапки Цикл
		Если Не СтрокаМаппинга.ИскатьСуществующий Или СтрокаМаппинга.ВсегдаСоздаватьНовый Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеФайла = ЗначенияПоКолонкам.Получить(СтрокаМаппинга.ИмяКолонкиФайла);
		Если Не ЗначениеЗаполнено(ЗначениеФайла) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаМаппинга.ЭтоСсылка Тогда
			ЗначениеРеквизита = ПолучитьСсылкуПоЗначениюФайла(ЗначениеФайла, СтрокаМаппинга, ПараметрыЗагрузки, КэшСсылок);
		Иначе
			ЗначениеРеквизита = ПривестиЗначение(ЗначениеФайла, СтрокаМаппинга.ИмяРеквизита, ПараметрыЗагрузки);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		ПроверитьИмяПоляОбъекта(ПараметрыЗагрузки.ТипДанных, ПараметрыЗагрузки.ИмяОбъектаМетаданных, СтрокаМаппинга.ИмяРеквизита);
		ИмяПараметра = "П" + Формат(ИндексПараметра, "ЧГ=0");
		Условия.Добавить("Т." + СтрокаМаппинга.ИмяРеквизита + " = &" + ИмяПараметра);
		Запрос.УстановитьПараметр(ИмяПараметра, ЗначениеРеквизита);
		ИндексПараметра = ИндексПараметра + 1;
	КонецЦикла;
	
	Если Условия.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПолноеИмя = ПолноеИмяОбъекта(ПараметрыЗагрузки.ТипДанных, ПараметрыЗагрузки.ИмяОбъектаМетаданных);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Т.Ссылка КАК Ссылка
	|ИЗ
	|	" + ПолноеИмя + " КАК Т
	|ГДЕ
	|	" + СтрСоединить(Условия, " И ");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область МетаданныеИТипы

Функция КоллекцияМетаданныхПоТипу(ТипДанных)
	
	Если ТипДанных = "Справочник" Тогда
		Возврат Метаданные.Справочники;
	ИначеЕсли ТипДанных = "Документ" Тогда
		Возврат Метаданные.Документы;
	ИначеЕсли ТипДанных = "РегистрСведений" Тогда
		Возврат Метаданные.РегистрыСведений;
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

Функция НайтиОбъектМетаданных(ТипДанных, ИмяОбъектаМетаданных)
	
	Коллекция = КоллекцияМетаданныхПоТипу(ТипДанных);
	Если Коллекция = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Коллекция.Найти(ИмяОбъектаМетаданных);
	
КонецФункции

Функция ПолноеИмяОбъекта(ТипДанных, ИмяОбъектаМетаданных)
	Возврат ТипДанных + "." + ИмяОбъектаМетаданных;
КонецФункции

Процедура ДобавитьСтандартныеРеквизиты(Результат, ОбъектМетаданных, ТипДанных)
	
	Если ТипДанных = "Справочник" Тогда
		Если ОбъектМетаданных.ДлинаКода > 0 Тогда
			ДобавитьСлужебноеПоле(Результат, "Код", "Код", "Строка", "СтандартныйРеквизит", Ложь, "", "Код");
		КонецЕсли;
		Если ОбъектМетаданных.ДлинаНаименования > 0 Тогда
			ДобавитьСлужебноеПоле(Результат, "Наименование", "Наименование", "Строка", "СтандартныйРеквизит", Ложь, "", "Наименование");
		КонецЕсли;
		Если ОбъектМетаданных.Иерархический Тогда
			ДобавитьСлужебноеПоле(
				Результат,
				"Родитель",
				"Родитель",
				ОбъектМетаданных.ПолноеИмя(),
				"СтандартныйРеквизит",
				Истина,
				ОбъектМетаданных.ПолноеИмя(),
				ИменаРеквизитовПоискаСсылки(ОбъектМетаданных.ПолноеИмя()));
		КонецЕсли;
		Если ОбъектМетаданных.Владельцы.Количество() > 0 Тогда
			ДобавитьСлужебноеПоле(Результат, "Владелец", "Владелец", "Ссылка", "СтандартныйРеквизит", Истина, "", "");
		КонецЕсли;
	ИначеЕсли ТипДанных = "Документ" Тогда
		ДобавитьСлужебноеПоле(Результат, "Номер", "Номер", "Строка", "СтандартныйРеквизит", Ложь, "", "Номер");
		ДобавитьСлужебноеПоле(Результат, "Дата", "Дата", "Дата", "СтандартныйРеквизит", Ложь, "", "Дата");
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОписаниеРеквизита(Результат, Реквизит, ИмяТабличнойЧасти, Категория)
	
	Описание = Новый Структура;
	Описание.Вставить("Имя", Реквизит.Имя);
	Описание.Вставить("Синоним", ?(ПустаяСтрока(Реквизит.Синоним), Реквизит.Имя, Реквизит.Синоним));
	Описание.Вставить("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
	Описание.Вставить("ТипПредставление", ПредставлениеОписанияТипов(Реквизит.Тип));
	Описание.Вставить("ЭтоСсылка", ЭтоСсылочноеОписаниеТипа(Реквизит.Тип));
	Описание.Вставить("ПолноеИмяСсылочногоТипа", ПолноеИмяПервойСсылки(Реквизит.Тип));
	Описание.Вставить("Категория", Категория);
	Описание.Вставить("ПроверкаЗаполнения", Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку);
	Описание.Вставить("ИменаРеквизитовПоиска", "");
	Если Описание.ЭтоСсылка И Не ПустаяСтрока(Описание.ПолноеИмяСсылочногоТипа) Тогда
		Описание.ИменаРеквизитовПоиска = ИменаРеквизитовПоискаСсылки(Описание.ПолноеИмяСсылочногоТипа);
	КонецЕсли;
	Результат.Добавить(Описание);
	
КонецПроцедуры

Процедура ДобавитьСлужебноеПоле(Результат, Имя, Синоним, ТипПредставление, Категория, ЭтоСсылка, ПолноеИмяСсылки, ИменаПоиска)
	
	Описание = Новый Структура;
	Описание.Вставить("Имя", Имя);
	Описание.Вставить("Синоним", Синоним);
	Описание.Вставить("ИмяТабличнойЧасти", "");
	Описание.Вставить("ТипПредставление", ТипПредставление);
	Описание.Вставить("ЭтоСсылка", ЭтоСсылка);
	Описание.Вставить("ПолноеИмяСсылочногоТипа", ПолноеИмяСсылки);
	Описание.Вставить("Категория", Категория);
	Описание.Вставить("ПроверкаЗаполнения", Категория = "Измерение" Или Имя = "Наименование" Или Имя = "Дата");
	Описание.Вставить("ИменаРеквизитовПоиска", ИменаПоиска);
	Результат.Добавить(Описание);
	
КонецПроцедуры

Функция ЭтоСсылочноеОписаниеТипа(ОписаниеТипа)
	
	Для Каждого Тип Из ОписаниеТипа.Типы() Цикл
		Если ЭтоСсылочныйТип(Тип) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
	
КонецФункции

Функция ЭтоСсылочныйТип(Тип)
	
	Возврат Справочники.ТипВсеСсылки().СодержитТип(Тип)
		Или Документы.ТипВсеСсылки().СодержитТип(Тип)
		Или Перечисления.ТипВсеСсылки().СодержитТип(Тип)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(Тип)
		Или ПланыСчетов.ТипВсеСсылки().СодержитТип(Тип)
		Или ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(Тип)
		Или БизнесПроцессы.ТипВсеСсылки().СодержитТип(Тип)
		Или Задачи.ТипВсеСсылки().СодержитТип(Тип)
		Или ПланыОбмена.ТипВсеСсылки().СодержитТип(Тип);
	
КонецФункции

Функция ПолноеИмяПервойСсылки(ОписаниеТипа)
	
	Для Каждого Тип Из ОписаниеТипа.Типы() Цикл
		Если ЭтоСсылочныйТип(Тип) Тогда
			ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
			Если ОбъектМетаданных <> Неопределено Тогда
				Возврат ОбъектМетаданных.ПолноеИмя();
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
	
КонецФункции

Функция ПредставлениеОписанияТипов(ОписаниеТипа)
	
	Имена = Новый Массив;
	Для Каждого Тип Из ОписаниеТипа.Типы() Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
		Если ОбъектМетаданных = Неопределено Тогда
			Имена.Добавить(Строка(Тип));
		Иначе
			Имена.Добавить(ОбъектМетаданных.ПолноеИмя());
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Имена, "; ");
	
КонецФункции

Функция ИменаРеквизитовПоискаСсылки(ПолноеИмя)
	
	Имена = Новый Массив;
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат "Наименование";
	КонецЕсли;
	
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Если ОбъектМетаданных.ДлинаКода > 0 Тогда
			Имена.Добавить("Код");
		КонецЕсли;
		Если ОбъектМетаданных.ДлинаНаименования > 0 Тогда
			Имена.Добавить("Наименование");
		КонецЕсли;
		Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
			Если Реквизит.Тип.СодержитТип(Тип("Строка")) Или Реквизит.Тип.СодержитТип(Тип("Число")) Тогда
				Имена.Добавить(Реквизит.Имя);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Имена.Добавить("Номер");
		Имена.Добавить("Дата");
	Иначе
		Имена.Добавить("Наименование");
	КонецЕсли;
	
	Возврат СтрСоединить(Имена, ",");
	
КонецФункции

Функция ИмяРеквизитаПоискаПоУмолчанию(ПолноеИмя)
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат "Наименование";
	КонецЕсли;
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) И ОбъектМетаданных.ДлинаНаименования > 0 Тогда
		Возврат "Наименование";
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Возврат "Номер";
	КонецЕсли;
	Возврат "Наименование";
	
КонецФункции

Процедура ПроверитьИмяРеквизитаПоиска(ПолноеИмя, ИмяРеквизитаПоиска)
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение "Не найден объект метаданных " + ПолноеИмя;
	КонецЕсли;
	Если Не ИмяПоляСуществует(ОбъектМетаданных, ИмяРеквизитаПоиска) Тогда
		ВызватьИсключение СтрШаблон("Реквизит поиска «%1» отсутствует в %2", ИмяРеквизитаПоиска, ПолноеИмя);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьИмяПоляОбъекта(ТипДанных, ИмяОбъектаМетаданных, ИмяПоля)
	
	ОбъектМетаданных = НайтиОбъектМетаданных(ТипДанных, ИмяОбъектаМетаданных);
	Если ОбъектМетаданных = Неопределено Или Не ИмяПоляСуществует(ОбъектМетаданных, ИмяПоля) Тогда
		ВызватьИсключение СтрШаблон("Поле «%1» отсутствует в %2.%3", ИмяПоля, ТипДанных, ИмяОбъектаМетаданных);
	КонецЕсли;
	
КонецПроцедуры

Функция ИмяПоляСуществует(ОбъектМетаданных, ИмяПоля)
	
	Стандартные = "Код,Наименование,Родитель,Владелец,Номер,Дата,Период,ПометкаУдаления";
	Если СтрНайти("," + Стандартные + ",", "," + ИмяПоля + ",") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если ОбъектМетаданных.Реквизиты.Найти(ИмяПоля) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Попытка
		Если ОбъектМетаданных.Измерения.Найти(ИмяПоля) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
		Если ОбъектМетаданных.Ресурсы.Найти(ИмяПоля) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Ложь;
	
КонецФункции

Функция ЕстьСтандартныйРеквизит(ПолноеИмя, ИмяРеквизита)
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат ОбъектМетаданных.СтандартныеРеквизиты[ИмяРеквизита] <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция МенеджерПоПолномуИмени(ПолноеИмя)
	
	ЧастиИмени = СтрРазделить(ПолноеИмя, ".");
	Вид = ЧастиИмени[0];
	Имя = ЧастиИмени[1];
	Если Вид = "Справочник" Тогда
		Возврат Справочники[Имя];
	ИначеЕсли Вид = "Документ" Тогда
		Возврат Документы[Имя];
	ИначеЕсли Вид = "Перечисление" Тогда
		Возврат Перечисления[Имя];
	ИначеЕсли Вид = "ПланВидовХарактеристик" Тогда
		Возврат ПланыВидовХарактеристик[Имя];
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат ПланыСчетов[Имя];
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Возврат ПланыВидовРасчета[Имя];
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат ПланыОбмена[Имя];
	КонецЕсли;
	ВызватьИсключение "Неподдерживаемый тип " + ПолноеИмя;
	
КонецФункции

Функция СоздатьОбъектМетаданных(ТипДанных, ИмяОбъектаМетаданных)
	
	Если ТипДанных = "Справочник" Тогда
		Возврат Справочники[ИмяОбъектаМетаданных].СоздатьЭлемент();
	ИначеЕсли ТипДанных = "Документ" Тогда
		ДокументОбъект = Документы[ИмяОбъектаМетаданных].СоздатьДокумент();
		Если Не ЗначениеЗаполнено(ДокументОбъект.Дата) Тогда
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		Возврат ДокументОбъект;
	КонецЕсли;
	ВызватьИсключение "Нельзя создать объект типа " + ТипДанных;
	
КонецФункции

Процедура УстановитьРеквизитОбъекта(ОбъектЗаписи, ИмяРеквизита, ЗначениеРеквизита)
	
	Если ИмяРеквизита = "Ссылка" Тогда
		Возврат;
	КонецЕсли;
	ОбъектЗаписи[ИмяРеквизита] = ЗначениеРеквизита;
	
КонецПроцедуры

Функция ПривестиЗначение(ЗначениеФайла, ИмяРеквизита, ПараметрыЗагрузки)
	
	Если Не ЗначениеЗаполнено(ЗначениеФайла) Тогда
		Возврат ЗначениеФайла;
	КонецЕсли;
	
	ОбъектМетаданных = НайтиОбъектМетаданных(ПараметрыЗагрузки.ТипДанных, ПараметрыЗагрузки.ИмяОбъектаМетаданных);
	ОписаниеТипа = ОписаниеТипаПоля(ОбъектМетаданных, ИмяРеквизита);
	Если ОписаниеТипа = Неопределено Тогда
		Возврат ЗначениеФайла;
	КонецЕсли;
	
	Возврат ПривестиКОписаниюТипа(ЗначениеФайла, ОписаниеТипа);
	
КонецФункции

Функция ПривестиЗначениеПоиска(ПолноеИмя, ИмяРеквизита, ЗначениеПоиска)
	
	ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	ОписаниеТипа = ОписаниеТипаПоля(ОбъектМетаданных, ИмяРеквизита);
	Если ОписаниеТипа = Неопределено Тогда
		Возврат ЗначениеПоиска;
	КонецЕсли;
	Возврат ПривестиКОписаниюТипа(ЗначениеПоиска, ОписаниеТипа);
	
КонецФункции

Функция ОписаниеТипаПоля(ОбъектМетаданных, ИмяПоля)
	
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Реквизит = ОбъектМетаданных.Реквизиты.Найти(ИмяПоля);
	Если Реквизит <> Неопределено Тогда
		Возврат Реквизит.Тип;
	КонецЕсли;
	Попытка
		Измерение = ОбъектМетаданных.Измерения.Найти(ИмяПоля);
		Если Измерение <> Неопределено Тогда
			Возврат Измерение.Тип;
		КонецЕсли;
		Ресурс = ОбъектМетаданных.Ресурсы.Найти(ИмяПоля);
		Если Ресурс <> Неопределено Тогда
			Возврат Ресурс.Тип;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Если ИмяПоля = "Дата" Или ИмяПоля = "Период" Тогда
		Возврат Новый ОписаниеТипов("Дата");
	КонецЕсли;
	Если ИмяПоля = "Код" Или ИмяПоля = "Наименование" Или ИмяПоля = "Номер" Тогда
		Возврат Новый ОписаниеТипов("Строка");
	КонецЕсли;
	Возврат Неопределено;
	
КонецФункции

Функция ПривестиКОписаниюТипа(ЗначениеФайла, ОписаниеТипа)
	
	Если ОписаниеТипа.СодержитТип(Тип("Булево")) Тогда
		ЗначениеНРег = НРег(СокрЛП(Строка(ЗначениеФайла)));
		Возврат (ЗначениеНРег = "да" Или ЗначениеНРег = "истина" Или ЗначениеНРег = "1" Или ЗначениеНРег = "true");
	КонецЕсли;
	
	Если ОписаниеТипа.СодержитТип(Тип("Дата")) Тогда
		ДатаЗначение = ДатаИзСтрокиФайла(ЗначениеФайла);
		Если ЗначениеЗаполнено(ДатаЗначение) Тогда
			Возврат ДатаЗначение;
		КонецЕсли;
	КонецЕсли;
	
	Если ОписаниеТипа.СодержитТип(Тип("Число")) Тогда
		Попытка
			Возврат Число(СтрЗаменить(СтрЗаменить(Строка(ЗначениеФайла), " ", ""), ",", "."));
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Попытка
		Возврат ОписаниеТипа.ПривестиЗначение(ЗначениеФайла);
	Исключение
		Возврат ЗначениеФайла;
	КонецПопытки;
	
КонецФункции

Функция ДатаИзСтрокиФайла(ЗначениеФайла)
	
	Текст = СокрЛП(Строка(ЗначениеФайла));
	Попытка
		Возврат Дата(Текст);
	Исключение
	КонецПопытки;
	
	Попытка
		ЧислоЗначение = Число(СтрЗаменить(Текст, ",", "."));
		Если ЧислоЗначение > 20000 И ЧислоЗначение < 80000 Тогда
			Возврат Дата(1899, 12, 30) + ЧислоЗначение * 86400;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область Вспомогательные

Функция НоваяСтрокаМаппинга(КолонкаФайла)
	
	СтрокаМаппинга = Новый Структура;
	СтрокаМаппинга.Вставить("ИмяКолонкиФайла", КолонкаФайла.Имя);
	СтрокаМаппинга.Вставить("ЗаголовокКолонкиФайла", КолонкаФайла.Заголовок);
	СтрокаМаппинга.Вставить("ИмяРеквизита", "");
	СтрокаМаппинга.Вставить("ПредставлениеРеквизита", "");
	СтрокаМаппинга.Вставить("ТипПредставление", "");
	СтрокаМаппинга.Вставить("ЭтоСсылка", Ложь);
	СтрокаМаппинга.Вставить("ПолноеИмяСсылочногоТипа", "");
	СтрокаМаппинга.Вставить("ИскатьСуществующий", Ложь);
	СтрокаМаппинга.Вставить("ВсегдаСоздаватьНовый", Ложь);
	СтрокаМаппинга.Вставить("Обязательный", Ложь);
	СтрокаМаппинга.Вставить("ИмяРеквизитаПоискаСсылки", "");
	СтрокаМаппинга.Вставить("ДействиеЕслиНеНайден", "ОставитьПустым");
	СтрокаМаппинга.Вставить("РазбиратьСоставнойКлюч", Ложь);
	СтрокаМаппинга.Вставить("РазделительКлюча", " / ");
	СтрокаМаппинга.Вставить("ИмяТабличнойЧасти", "");
	СтрокаМаппинга.Вставить("ИменаРеквизитовПоиска", "");
	Возврат СтрокаМаппинга;
	
КонецФункции

Процедура ЗаполнитьМаппингПоРеквизиту(СтрокаМаппинга, Реквизит)
	
	Если ПустаяСтрока(Реквизит.ИмяТабличнойЧасти) Тогда
		СтрокаМаппинга.ИмяРеквизита = Реквизит.Имя;
	Иначе
		СтрокаМаппинга.ИмяРеквизита = Реквизит.ИмяТабличнойЧасти + "." + Реквизит.Имя;
	КонецЕсли;
	СтрокаМаппинга.ПредставлениеРеквизита = Реквизит.Синоним;
	СтрокаМаппинга.ТипПредставление = Реквизит.ТипПредставление;
	СтрокаМаппинга.ЭтоСсылка = Реквизит.ЭтоСсылка;
	СтрокаМаппинга.ПолноеИмяСсылочногоТипа = Реквизит.ПолноеИмяСсылочногоТипа;
	СтрокаМаппинга.Обязательный = Реквизит.ПроверкаЗаполнения;
	СтрокаМаппинга.ИмяТабличнойЧасти = Реквизит.ИмяТабличнойЧасти;
	СтрокаМаппинга.ИменаРеквизитовПоиска = Реквизит.ИменаРеквизитовПоиска;
	СтрокаМаппинга.ИскатьСуществующий = (Реквизит.Имя = "Код" Или Реквизит.Имя = "Наименование" Или Реквизит.Имя = "Номер" Или Реквизит.Категория = "Измерение");
	Если Реквизит.ЭтоСсылка Тогда
		СтрокаМаппинга.ИмяРеквизитаПоискаСсылки = ИмяРеквизитаПоискаПоУмолчанию(Реквизит.ПолноеИмяСсылочногоТипа);
		СтрокаМаппинга.ДействиеЕслиНеНайден = "ОставитьПустым";
	КонецЕсли;
	
КонецПроцедуры

Функция ВесСовпаденияИмен(ЗаголовокНРег, Реквизит)
	
	СинонимНРег = НРег(СокрЛП(Реквизит.Синоним));
	ИмяНРег = НРег(Реквизит.Имя);
	Если ЗаголовокНРег = СинонимНРег Или ЗаголовокНРег = ИмяНРег Тогда
		Возврат 100;
	КонецЕсли;
	Если СтрНайти(СинонимНРег, ЗаголовокНРег) > 0 Или СтрНайти(ЗаголовокНРег, СинонимНРег) > 0 Тогда
		Возврат 80;
	КонецЕсли;
	Если СтрНайти(ИмяНРег, ЗаголовокНРег) > 0 Или СтрНайти(ЗаголовокНРег, ИмяНРег) > 0 Тогда
		Возврат 60;
	КонецЕсли;
	Возврат 0;
	
КонецФункции

Функция ВсегдаСоздаватьОбъект(ПоляШапки)
	
	ЕстьКлючПоиска = Ложь;
	Для Каждого СтрокаМаппинга Из ПоляШапки Цикл
		Если СтрокаМаппинга.ВсегдаСоздаватьНовый Тогда
			Возврат Истина;
		КонецЕсли;
		Если СтрокаМаппинга.ИскатьСуществующий Тогда
			ЕстьКлючПоиска = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Не ЕстьКлючПоиска;
	
КонецФункции

Функция НовыйЭлементПротокола(НомерСтрокиФайла, Статус, Описание, НавигационнаяСсылка, ПредставлениеОбъекта)
	
	Элемент = Новый Структура;
	Элемент.Вставить("НомерСтрокиФайла", НомерСтрокиФайла);
	Элемент.Вставить("Статус", Статус);
	Элемент.Вставить("Описание", Описание);
	Элемент.Вставить("НавигационнаяСсылка", НавигационнаяСсылка);
	Элемент.Вставить("ПредставлениеОбъекта", ПредставлениеОбъекта);
	Возврат Элемент;
	
КонецФункции

Функция ОпределитьКодировкуТекста(ИмяФайла)
	
	Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
	СтрокаФайла = Чтение.ПрочитатьСтроку();
	Чтение.Закрыть();
	Если СтрокаФайла <> Неопределено И СтрНайти(СтрокаФайла, "�") = 0 Тогда
		Возврат КодировкаТекста.UTF8;
	КонецЕсли;
	Возврат КодировкаТекста.ANSI;
	
КонецФункции

Функция ОпределитьРазделительCSV(ПерваяСтрока)
	
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(";");
	Кандидаты.Добавить(",");
	Кандидаты.Добавить(Символы.Таб);
	Лучший = ";";
	ЛучшийСчёт = 0;
	Для Каждого Кандидат Из Кандидаты Цикл
		Счёт = СтрЧислоВхождений(ПерваяСтрока, Кандидат);
		Если Счёт > ЛучшийСчёт Тогда
			ЛучшийСчёт = Счёт;
			Лучший = Кандидат;
		КонецЕсли;
	КонецЦикла;
	Возврат Лучший;
	
КонецФункции

Функция РазобратьСтрокуCSV(СтрокаФайла, Разделитель)
	
	Результат = Новый Массив;
	Текущее = "";
	ВКавычках = Ложь;
	Длина = СтрДлина(СтрокаФайла);
	Индекс = 1;
	Пока Индекс <= Длина Цикл
		Символ = Сред(СтрокаФайла, Индекс, 1);
		Если Символ = """" Тогда
			Если ВКавычках И Индекс < Длина И Сред(СтрокаФайла, Индекс + 1, 1) = """" Тогда
				Текущее = Текущее + """";
				Индекс = Индекс + 1;
			Иначе
				ВКавычках = Не ВКавычках;
			КонецЕсли;
		ИначеЕсли Символ = Разделитель И Не ВКавычках Тогда
			Результат.Добавить(СокрЛП(Текущее));
			Текущее = "";
		Иначе
			Текущее = Текущее + Символ;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	Результат.Добавить(СокрЛП(Текущее));
	Возврат Результат;
	
КонецФункции

Функция СтрокаПустая(СтрокаЗначений)
	
	Для Каждого Значение Из СтрокаЗначений Цикл
		Если ЗначениеЗаполнено(Значение) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

Функция ЗначениеЯчейкиПоТипу(ТипЯчейки, ЗначениеЯчейки, ОбщиеСтроки)
	
	Если ТипЯчейки = "s" Тогда
		Попытка
			Индекс = Число(ЗначениеЯчейки);
			Если Индекс >= 0 И Индекс < ОбщиеСтроки.Количество() Тогда
				Возврат ОбщиеСтроки[Индекс];
			КонецЕсли;
		Исключение
		КонецПопытки;
		Возврат ЗначениеЯчейки;
	КонецЕсли;
	Возврат ЗначениеЯчейки;
	
КонецФункции

Функция ИндексКолонкиИзАдреса(Адрес)
	
	Буквы = "";
	Для Индекс = 1 По СтрДлина(Адрес) Цикл
		Символ = ВРег(Сред(Адрес, Индекс, 1));
		Если СтрНайти("ABCDEFGHIJKLMNOPQRSTUVWXYZ", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
		Буквы = Буквы + Символ;
	КонецЦикла;
	
	Результат = 0;
	Для Индекс = 1 По СтрДлина(Буквы) Цикл
		Результат = Результат * 26 + КодСимвола(Сред(Буквы, Индекс, 1)) - КодСимвола("A") + 1;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Функция ЧислоИзАтрибута(Чтение, ИмяАтрибута, ЗначениеПоУмолчанию)
	
	Значение = Чтение.ПолучитьАтрибут(ИмяАтрибута);
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
	
КонецФункции

Функция ФайлСуществует(Путь)
	
	Файл = Новый Файл(Путь);
	Возврат Файл.Существует();
	
КонецФункции

Процедура УдалитьФайлБезопасно(Путь)
	
	Попытка
		УдалитьФайлы(Путь);
	Исключение
	КонецПопытки;
	
КонецПроцедуры

